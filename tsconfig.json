{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": ["node", "express"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",  // Para onde o código compilado será enviado
    "rootDir": "./src", 
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
